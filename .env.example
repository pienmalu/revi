# このファイルを .env.local にコピーして使う（本番は Vercel の Environment Variables に同じ名前で入れる）

# データベース。Neon の接続文字列（postgresql://...neon.tech/...）。
# 空なら、手元の data/pglite に Postgres を作って使う（開発用）
DATABASE_URL=

# PDF の置き場所。Vercel Blob の読み書き用トークン。空なら、手元の data/files に置く（開発用）
BLOB_READ_WRITE_TOKEN=

# Slack に貼るリンクの起点（本番は https://<プロジェクト名>.vercel.app）
BASE_URL=http://localhost:3000

# Slack アプリ（Basic Information → Signing Secret、OAuth & Permissions → Bot User OAuth Token）
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
# 手元で Slack を試すとき（pnpm slack:dev）だけ使う App-Level Token（xapp-...、connections:write）
SLACK_APP_TOKEN=
# 手元の Socket Mode 中継専用。ランダムな値を生成して設定する。本番では使わない
SLACK_DEV_SIGNING_SECRET=

# 毎朝のリマインド（Vercel Cron）の合言葉。自分で生成して Vercel に設定する
CRON_SECRET=
